{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyBusz/duckdb-dart/blob/mybusz/1.4.4-duckdb-1.4.2/native/native-artifacts.schema.json",
  "title": "DuckDB 1.4.2 native artifact lock manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseTag",
    "sourceCommit",
    "coreCommit",
    "toolchains",
    "staticExtensions",
    "licenses",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseTag": { "const": "native-duckdb-1.4.2-r1" },
    "sourceCommit": { "$ref": "#/$defs/gitCommit" },
    "coreCommit": {
      "const": "68d7555f68bd25c1a251ccca2e6338949c33986a"
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flutter", "dart", "androidNdk", "buildTools"],
      "properties": {
        "flutter": { "const": "3.41.3" },
        "dart": { "const": "3.11.1" },
        "androidNdk": { "const": "28.2.13676358" },
        "buildTools": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/cmakeTool" },
            { "$ref": "#/$defs/ninjaTool" },
            { "$ref": "#/$defs/linuxClangTool" },
            { "$ref": "#/$defs/xcodeTool" },
            { "$ref": "#/$defs/appleClangTool" },
            { "$ref": "#/$defs/visualStudioTool" },
            { "$ref": "#/$defs/msvcTool" }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "staticExtensions": {
      "type": "array",
      "prefixItems": [
        { "const": "icu" },
        { "const": "parquet" },
        { "const": "json" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "licenses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "identifier"],
          "properties": {
            "path": { "const": "LICENSE" },
            "identifier": { "const": "MIT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "identifier"],
          "properties": {
            "path": { "const": "licenses/duckdb/LICENSE" },
            "identifier": { "const": "MIT" }
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "artifacts": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/androidArtifact" },
        { "$ref": "#/$defs/iosArtifact" },
        { "$ref": "#/$defs/macosArtifact" },
        { "$ref": "#/$defs/linuxArtifact" },
        { "$ref": "#/$defs/windowsArtifact" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "buildTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "$ref": "#/$defs/toolVersion" }
      }
    },
    "cmakeTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "cmake" } } }
      ]
    },
    "ninjaTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "ninja" } } }
      ]
    },
    "linuxClangTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "linux-clang" } } }
      ]
    },
    "xcodeTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "xcode" } } }
      ]
    },
    "appleClangTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "apple-clang" } } }
      ]
    },
    "visualStudioTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "visual-studio" } } }
      ]
    },
    "msvcTool": {
      "allOf": [
        { "$ref": "#/$defs/buildTool" },
        { "properties": { "name": { "const": "msvc" } } }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "installDestination"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "installDestination": { "$ref": "#/$defs/relativePath" }
      }
    },
    "supportedPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architectures"],
      "properties": {
        "platform": {
          "enum": ["android", "ios", "ios-simulator", "macos", "linux", "windows"]
        },
        "architectures": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimumOsVersion": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "fileName",
        "size",
        "sha256",
        "supportedPlatforms",
        "members"
      ],
      "properties": {
        "target": { "enum": ["android", "ios", "macos", "linux", "windows"] },
        "fileName": { "type": "string" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "supportedPlatforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportedPlatform" },
          "minItems": 1
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "androidArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "target": { "const": "android" },
            "fileName": { "const": "duckdb-android-arm64-v8a-x86_64.zip" },
            "supportedPlatforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures", "minimumOsVersion"],
                  "properties": {
                    "platform": { "const": "android" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [
                        { "const": "arm64-v8a" },
                        { "const": "x86_64" }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minimumOsVersion": { "const": "21" }
                  }
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "members": {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/androidArm64Member" },
                { "$ref": "#/$defs/androidX64Member" }
              ],
              "items": { "$ref": "#/$defs/member" },
              "minItems": 2,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "iosArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "target": { "const": "ios" },
            "fileName": { "const": "duckdb-ios-xcframework.zip" },
            "supportedPlatforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures", "minimumOsVersion"],
                  "properties": {
                    "platform": { "const": "ios" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [{ "const": "arm64" }],
                      "items": false,
                      "minItems": 1,
                      "maxItems": 1
                    },
                    "minimumOsVersion": { "const": "13.0" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures", "minimumOsVersion"],
                  "properties": {
                    "platform": { "const": "ios-simulator" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [
                        { "const": "arm64" },
                        { "const": "x86_64" }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minimumOsVersion": { "const": "13.0" }
                  }
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "members": {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/iosInfoMember" },
                { "$ref": "#/$defs/iosDeviceMember" },
                { "$ref": "#/$defs/iosSimulatorMember" }
              ],
              "items": { "$ref": "#/$defs/member" },
              "minItems": 3,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "macosArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "target": { "const": "macos" },
            "fileName": { "const": "duckdb-macos-universal.zip" },
            "supportedPlatforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures", "minimumOsVersion"],
                  "properties": {
                    "platform": { "const": "macos" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [{ "const": "x86_64" }],
                      "items": false,
                      "minItems": 1,
                      "maxItems": 1
                    },
                    "minimumOsVersion": { "const": "10.15" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures", "minimumOsVersion"],
                  "properties": {
                    "platform": { "const": "macos" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [{ "const": "arm64" }],
                      "items": false,
                      "minItems": 1,
                      "maxItems": 1
                    },
                    "minimumOsVersion": { "const": "11.0" }
                  }
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "members": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/macosMember" }],
              "items": { "$ref": "#/$defs/member" },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "linuxArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "target": { "const": "linux" },
            "fileName": { "const": "duckdb-linux-x86_64.zip" },
            "supportedPlatforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures"],
                  "properties": {
                    "platform": { "const": "linux" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [{ "const": "x86_64" }],
                      "items": false,
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "members": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/linuxMember" }],
              "items": { "$ref": "#/$defs/member" },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "windowsArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "target": { "const": "windows" },
            "fileName": { "const": "duckdb-windows-x64.zip" },
            "supportedPlatforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["platform", "architectures"],
                  "properties": {
                    "platform": { "const": "windows" },
                    "architectures": {
                      "type": "array",
                      "prefixItems": [{ "const": "x64" }],
                      "items": false,
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "members": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/windowsMember" }],
              "items": { "$ref": "#/$defs/member" },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "androidArm64Member": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "arm64-v8a/libduckdb.so" },
          "installDestination": { "const": "android/src/main/jniLibs/arm64-v8a/libduckdb.so" }
        } }
      ]
    },
    "androidX64Member": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "x86_64/libduckdb.so" },
          "installDestination": { "const": "android/src/main/jniLibs/x86_64/libduckdb.so" }
        } }
      ]
    },
    "iosInfoMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "duckdb.xcframework/Info.plist" },
          "installDestination": { "const": "ios/Libraries/release/duckdb.xcframework/Info.plist" }
        } }
      ]
    },
    "iosDeviceMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "duckdb.xcframework/ios-arm64/duckdb.framework/duckdb" },
          "installDestination": { "const": "ios/Libraries/release/duckdb.xcframework/ios-arm64/duckdb.framework/duckdb" }
        } }
      ]
    },
    "iosSimulatorMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "duckdb.xcframework/ios-arm64_x86_64-simulator/duckdb.framework/duckdb" },
          "installDestination": { "const": "ios/Libraries/release/duckdb.xcframework/ios-arm64_x86_64-simulator/duckdb.framework/duckdb" }
        } }
      ]
    },
    "macosMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "libduckdb.dylib" },
          "installDestination": { "const": "macos/Libraries/release/libduckdb.dylib" }
        } }
      ]
    },
    "linuxMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "libduckdb.so" },
          "installDestination": { "const": "linux/Libraries/release/libduckdb.so" }
        } }
      ]
    },
    "windowsMember": {
      "allOf": [
        { "$ref": "#/$defs/member" },
        { "properties": {
          "path": { "const": "duckdb.dll" },
          "installDestination": { "const": "windows/Libraries/release/duckdb.dll" }
        } }
      ]
    }
  }
}

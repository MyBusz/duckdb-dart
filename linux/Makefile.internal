.PHONY: all release clean help

LINUX_DIR := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

all: release

release:
	$(MAKE) -f "$(LINUX_DIR)/Makefile" release \
		EXPECTED_WRAPPER_COMMIT="$(EXPECTED_WRAPPER_COMMIT)" OUTPUT_DIR="$(OUTPUT_DIR)"

clean:
	$(MAKE) -f "$(LINUX_DIR)/Makefile" clean

help:
	$(MAKE) -f "$(LINUX_DIR)/Makefile" help
